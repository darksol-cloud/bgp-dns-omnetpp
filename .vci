attr network bgpdns.FairComparisonNetwork
attr processid 11087
attr repetition 2
attr replication #2
attr resultdir /tmp/bgpdns_sanity
attr runnumber 5
attr seedset 2
itervar bgp false
itervar dns true
config result-dir /tmp/bgpdns_sanity
config description "Quick comparison: BGP vs DNS on small network"
config repeat 3
config sim-time-limit 60s
config *.numNodes 25
config *.gridWidth 5
config *.gridHeight 5
config *.node[0].isPublisher true
config *.node[0].isAuthority true
config *.node[0].publishEids "\"1-10\""
config *.node[0].publishStartTime 3s
config *.node[12].isResolver true
config *.node[12].authorityNodeId 0
config *.node[24].isClient true
config *.node[24].queryEids "\"1-10\""
config *.node[24].queryCount 50
config *.node[24].queryInterval 0.5s
config *.node[24].queryStartTime 5s
config *.node[24].resolverNodeId 12
config *.node[24].authorityNodeId 0
config *.node[*].bgpEnabled false
config *.node[*].dnsEnabled true
config *.node[*].dnsDirectMode true
config *.node[*].dnsBaseRtt 0s
config *.node[*].dnsTtl 60s
config *.groundTruth.verboseLogging true
config *.groundTruth.snapshotInterval 5s
config network bgpdns.FairComparisonNetwork
config sim-time-limit 120s
config warmup-period 2s
config output-scalar-file /tmp/bgpdns_sanity/Exp_QuickCompare-bgp=false,dns=true-
config output-vector-file /tmp/bgpdns_sanity/Exp_QuickCompare-bgp=false,dns=true-
config seed-set 2
config **.result-recording-modes default,+histogram
config **.channel.delay 10ms

