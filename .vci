file 397312 1781062362                                          
version 3
run Exp_QuickCompare-5-20260610-00:32:42-11087
attr configname Exp_QuickCompare
attr datetime 20260610-00:32:42
attr datetimef 20260610-003242
attr experiment Exp_QuickCompare
attr inifile simulations/experiments.ini
attr iterationvars "$bgp=false, $dns=true"
attr iterationvarsd bgp=false/dns=true
attr iterationvarsf bgp=false,dns=true-
