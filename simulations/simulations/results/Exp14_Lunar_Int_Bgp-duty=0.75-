config cmdenv-express-mode true
config result-dir simulations/results
config extends Exp12_Lunar_Bgp
config description "Experiment 14: Lunar network with intermittent Earth-Moon trunk - BGP"
config *.earthDsn.port$o[0].channel.contactPeriod 600s
config *.earthDsn.port$o[0].channel.contactDuty 0.75
config *.gateway.port$o[0].channel.contactPeriod 600s
config *.gateway.port$o[0].channel.contactDuty 0.75
config extends Exp12_Lunar_Base
config description "Experiment 12: Lunar Artemis network - BGP"
config *.earthDsn.isPublisher true
config *.earthDsn.publishEids "\"1-5\""
config *.earthDsn.publishStartTime 2s
config *.southPoleBase.isPublisher true
config *.southPoleBase.publishEids "\"6-8\""
config *.southPoleBase.publishStartTime 5s
config *.rover[0].isPublisher true
config *.rover[0].publishEids "\"9-10\""
config *.rover[2].isPublisher true
config *.rover[2].publishEids "\"11-12\""
config *.rover[*].publishStartTime 10s
config *.fieldAsset[0].isPublisher true
config *.fieldAsset[0].publishEids "\"13\""
config *.fieldAsset[2].isPublisher true
config *.fieldAsset[2].publishEids "\"14-15\""
config *.fieldAsset[*].publishStartTime 15s
config *.rover[*].churnInterval 120s
config *.rover[*].churnProbability 0.15
config *.rover[0].isClient true
config *.rover[0].queryEids "\"6-15\""
config *.rover[0].queryCount 50
config *.rover[0].queryInterval 5s
config *.rover[0].queryStartTime 30s
config *.rover[1].isClient true
config *.rover[1].queryEids "\"1-5\""
config *.rover[1].queryCount 30
config *.rover[1].queryInterval 10s
config *.rover[1].queryStartTime 40s
config *.gateway.isClient true
config *.gateway.queryEids "\"1-15\""
config *.gateway.queryCount 40
config *.gateway.queryInterval 8s
config *.gateway.queryStartTime 20s
config *.earthDsn.bgpEnabled true
config *.gateway.bgpEnabled true
config *.southPoleBase.bgpEnabled true
config *.equatorialRelay.bgpEnabled true
config *.rover[*].bgpEnabled true
config *.fieldAsset[*].bgpEnabled true
config *.earthDsn.dnsEnabled false
config *.gateway.dnsEnabled false
config *.southPoleBase.dnsEnabled false
config *.equatorialRelay.dnsEnabled false
config *.rover[*].dnsEnabled false
config *.fieldAsset[*].dnsEnabled false
config network bgpdns.LunarArtemisNetwork
config sim-time-limit 1200s
config repeat 5
config *.earthDsn.nodeId 0
config *.gateway.nodeId 1
config *.southPoleBase.nodeId 2
config *.equatorialRelay.nodeId 3
config *.rover[*].nodeId "4 + index"
config *.fieldAsset[*].nodeId "8 + index"
config *.groundTruth.totalNodes 12
config *.groundTruth.snapshotInterval 60s
config network bgpdns.FairComparisonNetwork
config sim-time-limit 120s
config warmup-period 2s
config output-scalar-file simulations/results/Exp14_Lunar_Int_Bgp-duty=0.75-
config output-vector-file simulations/results/Exp14_Lunar_Int_Bgp-duty=0.75-
config seed-set 4
config **.result-recording-modes default,+histogram
config **.channel.delay 10ms

