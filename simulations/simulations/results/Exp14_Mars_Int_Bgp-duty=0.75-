itervar duty 0.75
config cmdenv-express-mode true
config result-dir simulations/results
config extends Exp13_Mars_Bgp
config description "Experiment 14: Mars network with intermittent Earth-Mars trunk - BGP"
config *.earthDsn.port$o[0].channel.contactPeriod 1800s
config *.earthDsn.port$o[0].channel.contactDuty 0.75
config *.marsOrbiter.port$o[0].channel.contactPeriod 1800s
config *.marsOrbiter.port$o[0].channel.contactDuty 0.75
config extends Exp13_Mars_Base
config description "Experiment 13: Mars exploration network - BGP"
config *.earthDsn.isPublisher true
config *.earthDsn.publishEids "\"1-3\""
config *.earthDsn.publishStartTime 5s
config *.jezeroHabitat.isPublisher true
config *.jezeroHabitat.publishEids "\"4-6\""
config *.jezeroHabitat.publishStartTime 10s
config *.olympusOutpost.isPublisher true
config *.olympusOutpost.publishEids "\"7-8\""
config *.olympusOutpost.publishStartTime 15s
config *.rover[0].isPublisher true
config *.rover[0].publishEids "\"9\""
config *.rover[2].isPublisher true
config *.rover[2].publishEids "\"10\""
config *.rover[*].publishStartTime 20s
config *.instrument[0].isPublisher true
config *.instrument[0].publishEids "\"11\""
config *.instrument[1].isPublisher true
config *.instrument[1].publishEids "\"12\""
config *.instrument[*].publishStartTime 30s
config *.rover[*].churnInterval 300s
config *.rover[*].churnProbability 0.1
config *.rover[0].isClient true
config *.rover[0].queryEids "\"4-12\""
config *.rover[0].queryCount 40
config *.rover[0].queryInterval 20s
config *.rover[0].queryStartTime 200s
config *.jezeroHabitat.isClient true
config *.jezeroHabitat.queryEids "\"1-12\""
config *.jezeroHabitat.queryCount 30
config *.jezeroHabitat.queryInterval 30s
config *.jezeroHabitat.queryStartTime 300s
config *.marsOrbiter.isClient true
config *.marsOrbiter.queryEids "\"1-12\""
config *.marsOrbiter.queryCount 25
config *.marsOrbiter.queryInterval 40s
config *.marsOrbiter.queryStartTime 250s
config *.earthDsn.bgpEnabled true
config *.marsOrbiter.bgpEnabled true
config *.jezeroHabitat.bgpEnabled true
config *.olympusOutpost.bgpEnabled true
config *.rover[*].bgpEnabled true
config *.instrument[*].bgpEnabled true
config *.earthDsn.dnsEnabled false
config *.marsOrbiter.dnsEnabled false
config *.jezeroHabitat.dnsEnabled false
config *.olympusOutpost.dnsEnabled false
config *.rover[*].dnsEnabled false
config *.instrument[*].dnsEnabled false
config network bgpdns.MarsExplorationNetwork
config sim-time-limit 3600s
config repeat 5
config *.earthDsn.nodeId 0
config *.marsOrbiter.nodeId 1
config *.jezeroHabitat.nodeId 2
config *.olympusOutpost.nodeId 3
config *.rover[*].nodeId "4 + index"
config *.instrument[*].nodeId "8 + index"
config *.groundTruth.totalNodes 10
config *.groundTruth.snapshotInterval 120s
config network bgpdns.FairComparisonNetwork
config sim-time-limit 120s
config warmup-period 2s
config output-scalar-file simulations/results/Exp14_Mars_Int_Bgp-duty=0.75-
config output-vector-file simulations/results/Exp14_Mars_Int_Bgp-duty=0.75-
config seed-set 4
config **.result-recording-modes default,+histogram
config **.channel.delay 10ms

